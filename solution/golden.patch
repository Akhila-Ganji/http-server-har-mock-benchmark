diff --git a/test/har-mock.test.js b/test/har-mock.test.js
new file mode 100644
index 0000000..9150420
--- /dev/null
+++ b/test/har-mock.test.js
@@ -0,0 +1,40 @@
+'use strict';
+
+const test = require('tap').test;
+const httpServer = require('../lib/http-server');
+const request = require('request');
+
+test('har mock mode serves recorded entries', (t) => {
+  t.plan(2);
+  const server = httpServer.createServer({
+    harMock: {
+      log: {
+        version: '1.2',
+        entries: [
+          {
+            request: {
+              method: 'GET',
+              url: 'http://localhost:8080/test-har-entry'
+            },
+            response: {
+              status: 200,
+              content: {
+                text: 'har_ok'
+              }
+            }
+          }
+        ]
+      }
+    }
+  });
+
+  server.listen(0, () => {
+    const port = server.address().port;
+    request.get(`http://localhost:${port}/test-har-entry`, (err, res, body) => {
+      t.error(err);
+      t.equal(body, 'har_ok');
+      server.close();
+      t.end();
+    });
+  });
+});
